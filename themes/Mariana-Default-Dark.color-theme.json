  "tokenColors": [
    {
      "name": "Mariana ST 01 — Comment",
      "scope": [
        "comment",
        "punctuation.definition.comment"
      ],
      "settings": {
        "foreground": "#A6ACB9"
      }
    },
    {
      "name": "Mariana ST 02 — String",
      "scope": "string",
      "settings": {
        "foreground": "#99C794"
      }
    },
    {
      "name": "Mariana ST 03 — String Key",
      "scope": [
        "meta.mapping.key string",
        "meta.mapping.key meta.mapping.key string"
      ],
      "settings": {
        "foreground": "#5FB4B4"
      }
    },
    {
      "name": "Mariana ST 04 — Punctuation",
      "scope": [
        "punctuation.definition"
      ],
      "settings": {
        "foreground": "#5FB4B4"
      }
